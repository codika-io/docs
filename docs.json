{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Codika Documentation",
  "colors": {
    "primary": "#1E1432",
    "light": "#A78BFA",
    "dark": "#150E24"
  },
  "fonts": {
    "heading": {
      "family": "Satoshi",
      "weight": 700,
      "source": "https://cdn.fontshare.com/wf/BNPRT3ODDLFBWCXYJT3DHQD5HQ6KXIUF/TQZKMSQ7LSXFQXBNSJKXWQR3KMBNHYXW/SATOSHI-BOLD.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "Geist"
    }
  },
  "background": {
    "color": {
      "light": "#FDFCFB",
      "dark": "#0A0F1E"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://codika.io"
  },
  "appearance": {
    "default": "system"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["index", "quickstart", "guides/claude-code-plugin"]
          },
          {
            "group": "Why Codika",
            "pages": [
              "why-codika/overview",
              "why-codika/vs-n8n",
              "why-codika/with-agents"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/use-cases",
              "concepts/processes",
              "concepts/workflows",
              "concepts/placeholders",
              "concepts/triggers",
              "concepts/credentials",
              "concepts/schemas",
              "concepts/agent-skills"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/first-use-case",
              "guides/ai-workflows",
              "guides/sub-workflows",
              "guides/deployment-parameters",
              "guides/file-uploads",
              "guides/agent-skills"
            ]
          },
          {
            "group": "Builder System",
            "pages": [
              "builder/overview",
              "builder/agents",
              "builder/workflows",
              "builder/reference"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "examples/overview",
              "examples/simple-search",
              "examples/email-automation",
              "examples/scheduled-report",
              "examples/complex-rag"
            ]
          }
        ]
      },
      {
        "tab": "CLI Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["operations/overview"]
          },
          {
            "group": "Setup",
            "pages": [
              "operations/authentication",
              "operations/create-project",
              "operations/create-organization",
              "operations/create-organization-key"
            ]
          },
          {
            "group": "Build",
            "pages": [
              "operations/init-use-case",
              "operations/verify-use-case"
            ]
          },
          {
            "group": "Deploy",
            "pages": [
              "operations/deploy-use-case",
              "operations/deploy-data-ingestion",
              "operations/deploy-documents",
              "operations/publish-use-case",
              "operations/redeploy-use-case"
            ]
          },
          {
            "group": "Operate",
            "pages": [
              "operations/trigger-workflow",
              "operations/fetch-use-case",
              "operations/get-execution",
              "operations/list-executions",
              "operations/get-skills",
              "operations/manage-integrations",
              "operations/status"
            ]
          }
        ]
      },
      {
        "tab": "Dashboard Integration",
        "groups": [
          {
            "group": "Overview",
            "pages": ["dashboard/overview"]
          },
          {
            "group": "Guides",
            "pages": [
              "dashboard/authentication",
              "dashboard/triggering-workflows",
              "dashboard/environments",
              "dashboard/patterns"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/codika-io",
          "icon": "github"
        },
        {
          "anchor": "Platform",
          "href": "https://app.codika.io",
          "icon": "rocket"
        },
        {
          "anchor": "Website",
          "href": "https://codika.io",
          "icon": "globe"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:team@codika.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://app.codika.io"
    }
  },
  "contextual": {
    "options": ["copy", "view", "claude", "cursor", "mcp"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/codika-io",
      "linkedin": "https://linkedin.com/company/codika"
    }
  }
}
